# Copy to .env and fill in. .env is gitignored.
# Read by docker compose and by the backend (app/core/settings.py).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=h2open
POSTGRES_USER=h2open
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Firebase service account for push messages to the drivers' app.
# Firebase console > Project settings > Service accounts > Generate new
# private key. Save it as secrets/firebase-service-account.json and run
# chmod 600 on it. Relative paths are from the repository root. Leave
# empty to skip push messages (they are logged instead).
FCM_CREDENTIALS_FILE=secrets/firebase-service-account.json

# Asterisk REST Interface (ARI), used by the backend to control calls.
# Read by the asterisk container and by the backend.
ARI_USERNAME=h2open
# Generate one with: openssl rand -hex 24
ARI_PASSWORD=

# The AudioCodes MP-114 on the LAN (its IP address), and the logins its two
# FXS ports (desk phones) register to Asterisk with: user desk1 / desk2.
# Enter the same passwords on the MP-114's Authentication page.
MP114_ADDRESS=
# Generate with: openssl rand -hex 12
DESK1_PASSWORD=
DESK2_PASSWORD=

# Where the backend API listens (docker compose). 127.0.0.1 keeps it on this
# machine; set 0.0.0.0 to let the POS reach it over the LAN.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
